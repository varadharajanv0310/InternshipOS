# Local start needs no paid service or account. Hosted installations must use Postgres.
DATABASE_URL=sqlite:///./data/internshipos.db
# DATABASE_URL=postgresql+psycopg://user:password@host/internshipos?sslmode=require
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
PUBLIC_BASE_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5173
OWNER_PASSWORD=
# Generate a long random value before exposing the API outside localhost.
AUTH_SECRET=
# Google refresh credentials are encrypted; keep a stable backup of this key.
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/google/callback
OPENAI_API_KEY=
AI_PROVIDER=openai
# Compatible providers use HTTPS plus AI_API_KEY; local uses a loopback endpoint.
AI_BASE_URL=
AI_API_KEY=
# Custom paid models require explicit prices per 1M tokens for each configured tier.
# AI_CHEAP_INPUT_USD_PER_MILLION=
# AI_CHEAP_OUTPUT_USD_PER_MILLION=
# AI_STRONG_INPUT_USD_PER_MILLION=
# AI_STRONG_OUTPUT_USD_PER_MILLION=
AI_CHEAP_MODEL=gpt-6-luna
AI_STRONG_MODEL=gpt-6.1-sol
AI_MONTHLY_BUDGET=2.50
SCHEDULER_ENABLED=true
COLLECTION_BATCH_SIZE=12
COLLECTION_CONCURRENCY=3
APP_DATA_DIR=./data
# Hosted/serverless installs use /tmp/internshipos; primary data lives in Postgres.
PDF_ENGINE=reportlab
# Separate optional Python 3.11/3.12 interpreter when the app uses Python 3.13.
# JOBSPY_PYTHON=./backend/.jobspy-venv/Scripts/python.exe
